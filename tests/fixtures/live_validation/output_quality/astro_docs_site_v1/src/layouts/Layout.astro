---
const { title = "Ops Atlas" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        background: #f7f4ec;
        color: #14212b;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(180deg, #fffef9 0%, #f3eee2 100%);
      }
      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      a {
        color: inherit;
      }
      .eyebrow {
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #695944;
      }
      .hero {
        padding: 3rem 0 2rem;
      }
      .hero h1 {
        margin: 0;
        font-size: clamp(2.6rem, 5vw, 4.8rem);
        line-height: 0.95;
      }
      .hero p {
        max-width: 46rem;
        font-size: 1.1rem;
        line-height: 1.6;
        color: #334155;
      }
      .panel {
        border: 1px solid rgba(20, 33, 43, 0.12);
        background: rgba(255, 255, 255, 0.86);
        border-radius: 1.25rem;
        padding: 1.25rem;
        box-shadow: 0 18px 48px rgba(20, 33, 43, 0.08);
      }
      .grid {
        display: grid;
        gap: 1rem;
      }
      .grid.two {
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      }
      .badge {
        display: inline-flex;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: #eadfc8;
        color: #4a3f31;
        font-size: 0.8rem;
        margin-right: 0.35rem;
      }
      .stack {
        display: grid;
        gap: 0.75rem;
      }
      input[type="search"] {
        width: 100%;
        padding: 0.9rem 1rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(20, 33, 43, 0.18);
        font-size: 1rem;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
