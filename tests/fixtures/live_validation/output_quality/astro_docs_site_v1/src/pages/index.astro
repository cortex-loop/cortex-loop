---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Ops Atlas">
  <Header />
  <main>
    <section class="hero">
      <div class="eyebrow">Field guide</div>
      <h1>Operational docs for product teams that ship under pressure.</h1>
      <p>
        This starter site already has the brand shell and the base content set.
        The docs surface is the missing piece.
      </p>
    </section>
    <section class="grid two">
      <article class="panel">
        <h2>Docs area</h2>
        <p>Docs links and tag navigation still need to be wired into the site properly.</p>
      </article>
      <article class="panel">
        <h2>Team notes</h2>
        <p>Keep this implementation simple enough that another engineer could extend it next week.</p>
      </article>
    </section>
  </main>
</Layout>
