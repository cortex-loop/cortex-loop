---
const { title = "Beacon Studio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        font-family: "Space Grotesk", system-ui, sans-serif;
        color: #112031;
        background: #fbf8f1;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top right, rgba(245, 179, 66, 0.22), transparent 28rem),
          linear-gradient(180deg, #fffef9 0%, #f4efe3 100%);
      }
      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      .hero {
        padding: 3rem 0 2rem;
      }
      .hero h1 {
        margin: 0;
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 0.94;
      }
      .hero p {
        max-width: 46rem;
        font-size: 1.05rem;
        line-height: 1.7;
      }
      .panel {
        border-radius: 1.25rem;
        border: 1px solid rgba(17, 32, 49, 0.12);
        background: rgba(255, 255, 255, 0.84);
        box-shadow: 0 18px 48px rgba(17, 32, 49, 0.08);
        padding: 1.25rem;
      }
      .grid {
        display: grid;
        gap: 1rem;
      }
      .grid.two {
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      }
      form {
        display: grid;
        gap: 0.85rem;
      }
      label {
        display: grid;
        gap: 0.35rem;
        font-weight: 600;
      }
      input, textarea, select {
        font: inherit;
        border-radius: 0.8rem;
        border: 1px solid rgba(17, 32, 49, 0.18);
        padding: 0.85rem 0.95rem;
      }
      button {
        font: inherit;
        border: 0;
        border-radius: 999px;
        padding: 0.85rem 1.2rem;
        background: #c96e1f;
        color: white;
        width: fit-content;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
