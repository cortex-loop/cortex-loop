---
const links = [
  { href: "/", label: "Home" },
  { href: "/resources/", label: "Resources" },
  { href: "/contact/", label: "Contact" },
];
---

<header style="border-bottom: 1px solid rgba(17, 32, 49, 0.12); background: rgba(255,255,255,0.72); backdrop-filter: blur(16px);">
  <div style="max-width: 72rem; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; gap: 1rem; align-items: center;">
    <a href="/" style="font-weight: 700; text-decoration: none;">Beacon Studio</a>
    <nav aria-label="Primary">
      <ul style="display: flex; gap: 1rem; list-style: none; padding: 0; margin: 0;">
        {links.map((link) => (
          <li><a href={link.href} style="text-decoration: none;">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
